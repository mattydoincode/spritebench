# Credentials for administering the deployed stack from this machine:
# migrations, a psql shell, Drizzle Studio, R2 checks. Copy to `.env.remote`,
# which is gitignored.
#
#   cp .env.remote.example .env.remote
#
# This file is NOT how the deployed app is configured. The running web service
# and worker read their environment from `infra/do-app.yaml` and the App
# Platform control panel. Anything here is only for commands you run locally
# against production, so it holds the same credentials but is not their source
# of truth -- when you rotate a key, change it in both places.
#
# Named `.env.remote` rather than `.env.production.local` on purpose: Next
# loads the latter automatically whenever NODE_ENV=production, so a local
# `npm run build && npm start` would silently connect to the live database.
# Next ignores this filename, so it is only ever used when asked for by name.

# --- Database ---------------------------------------------------------------
# From the DigitalOcean console, Connection Details, with the database AND user
# dropdowns both set to `spritebench`. Do not use the doadmin string: objects
# created by doadmin are not accessible to the app's role, and the app has no
# business holding a superuser credential.
#
#   doctl databases connection <cluster-id> --format Host,Port
#   doctl databases user get <cluster-id> spritebench --format Password
DATABASE_URL=postgresql://spritebench:PASSWORD@spritebench-prod-do-user-000000-0.k.db.ondigitalocean.com:25060/spritebench?sslmode=require

# Managed Postgres reached over the internet. Read by both the query pool and
# pg-boss; "disable" here fails to connect at all.
DATABASE_SSL=require

# --- Object storage ---------------------------------------------------------
STORAGE_DRIVER=r2
R2_BUCKET=spritebench-prod

# R2 dashboard: Manage R2 API Tokens, Object Read & Write, scoped to the
# bucket above. The account ID is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Credentials ------------------------------------------------------------
# Must match the deployed ENCRYPTION_KEY exactly, or provider keys written by
# the live app cannot be read locally. Only needed for commands that touch
# stored provider keys; leave blank for migrations and R2 checks.
ENCRYPTION_KEY=

# --- Limits -----------------------------------------------------------------
# Only consulted by locally run admin commands. The deployed app takes these
# from the App Platform spec, so leaving them out changes nothing about
# production; they are here so a local run behaves like the real thing.
FREE_ASSET_LIMIT=100
ASSET_RETENTION_DAYS=30
DATABASE_POOL_MAX=4
QUEUE_POOL_MAX=2
