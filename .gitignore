node_modules/
.next/
next-env.d.ts
tsconfig.tsbuildinfo

# `.env` is tracked and holds non-secret defaults. These two are not, and are
# kept ignored even though .env.remote is no longer part of the workflow --
# production secrets live in the DigitalOcean control panel now, and this is
# the net that catches a stray copy.
.env.local
.env.remote
.env.*.local

data/
# Local library used to verify the Postgres and object-storage migration.
data-pg/

# Bundled worker and migrator, built by `npm run build:node`.
dist/

# Local pg_dump copies.
.backups/

# App Platform spec with real secret values filled in. `doctl apps update`
# overwrites every variable it is given, so pushing the committed spec (whose
# SECRET values are empty) would blank them; keep an unredacted copy here.
infra/do-app.local.yaml

# Cursor MCP config, which holds API tokens.
.cursor/mcp.json
