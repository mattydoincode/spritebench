# --- Database ---------------------------------------------------------------
# Local development: `docker compose up -d` (or podman) then use this URL.
# Railway injects its own DATABASE_URL in production.
DATABASE_URL=postgres://art:art@localhost:5433/art_studio

# TLS for both the query pool and pg-boss: "require" or "disable". Defaults to
# disable, which is right for a local container and for a provider's private
# network. Set it to require only for a database reached over the internet --
# guessing from the hostname gets private network names wrong.
DATABASE_SSL=disable

# --- Object storage ---------------------------------------------------------
# "local" writes under SPRITEBENCH_DATA_DIR; "r2" uses the S3-compatible driver.
STORAGE_DRIVER=local
SPRITEBENCH_DATA_DIR=./data

# Only needed when STORAGE_DRIVER=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: a custom domain in front of the bucket. Serves objects directly
# instead of signing every read.
R2_PUBLIC_BASE=
# Optional: overrides the Cloudflare endpoint, for MinIO or another
# S3-compatible store. Also what `scripts/verify-s3.ts` points at.
R2_ENDPOINT=

# --- Credentials ------------------------------------------------------------
# Encrypts stored provider keys at rest. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Fallback used when a user has no stored key. Convenient locally; in
# production users bring their own.
OPENAI_API_KEY=

# --- Limits -----------------------------------------------------------------
# Provider calls in flight at once, per worker process.
WORKER_CONCURRENCY=4
# Images a free account may keep before generation is refused.
FREE_ASSET_LIMIT=100
# Days a full-resolution source is kept before roll-off. Rows and thumbnails
# are kept forever.
ASSET_RETENTION_DAYS=30
# Hard ceiling on batches x imageCount for a single request.
MAX_IMAGES_PER_REQUEST=40

# --- Optional ---------------------------------------------------------------
# Pins the acting user. Leave unset and the first row is used, created on
# demand, which is what local development wants.
SINGLE_USER_ID=

# Connection ceilings. Railway's Postgres allows far fewer connections than
# the defaults would suggest once both services and pg-boss are counted.
DATABASE_POOL_MAX=10
QUEUE_POOL_MAX=4
# How long a shutting-down worker waits for in-flight generations to finish.
QUEUE_DRAIN_TIMEOUT_MS=30000
