# Defaults for local development. TRACKED IN GIT -- never put a credential
# here. Secrets and machine-specific overrides go in `.env.local`, which is
# gitignored and takes precedence over this file.
#
# Production is configured in the DigitalOcean control panel, not here. Neither
# of these files is read by the deployed app.

# --- Database ---------------------------------------------------------------
# The container `npm run dev:up` starts.
DATABASE_URL=postgres://art:art@localhost:5433/art_studio

# TLS for the query pool and pg-boss alike: "require" or "disable". A local
# container terminates nothing, so disable. Managed Postgres over the internet
# needs require -- inferring it from the hostname gets private network names
# wrong, so it is stated outright.
DATABASE_SSL=disable

# --- Object storage ---------------------------------------------------------
# "local" writes under SPRITEBENCH_DATA_DIR; "r2" uses the S3-compatible
# driver and then requires the R2_* credentials.
STORAGE_DRIVER=local
SPRITEBENCH_DATA_DIR=./data-pg

# --- Limits -----------------------------------------------------------------
# Provider calls in flight at once, per worker process.
WORKER_CONCURRENCY=4
# Images a free account may keep before generation is refused.
FREE_ASSET_LIMIT=100
# Days a full-resolution source is kept before roll-off. Rows and thumbnails
# are kept indefinitely.
ASSET_RETENTION_DAYS=30
# Hard ceiling on batches x imageCount for a single request.
MAX_IMAGES_PER_REQUEST=40

# Connection ceilings. Managed Postgres allows far fewer connections than the
# defaults suggest once both processes and pg-boss are counted.
DATABASE_POOL_MAX=10
QUEUE_POOL_MAX=4
# How long a shutting-down worker waits for in-flight generations to finish.
QUEUE_DRAIN_TIMEOUT_MS=30000

# --- Declared here, set in .env.local ---------------------------------------
# Listed so `scripts/env-run.sh` knows to clear them from the environment, and
# so `configProblems()` has a single place naming what the app expects. Values
# belong in .env.local.
#
# Encrypts stored provider keys at rest:  openssl rand -base64 32
ENCRYPTION_KEY=
# Fallback when a user has no stored key. Convenient locally; in production
# users bring their own.
OPENAI_API_KEY=
# Pins the acting user. Unset means the first row, created on demand.
SINGLE_USER_ID=
# Only needed when STORAGE_DRIVER=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: a custom domain in front of the bucket, serving objects directly
# instead of signing every read.
R2_PUBLIC_BASE=
# Optional: overrides the Cloudflare endpoint for MinIO or another
# S3-compatible store. Also what `scripts/verify-s3.ts` points at.
R2_ENDPOINT=
