# Every variable the app reads, declared once, with the values production
# wants. This file is TRACKED and ships inside the image, so it must contain no
# credentials — the blank ones below are filled in by the DigitalOcean control
# panel in production and by `.env.local` on your machine.
#
# Overriding: whatever is already in the environment wins, then `.env.local`,
# then this file. So the platform beats the image, and your machine beats both.
#
# Defaults live here rather than in code. There is no fallback value anywhere
# in src/, which is what keeps a variable from having two homes.

# --- Set per environment, no safe default ------------------------------------
# Production gets DATABASE_URL from the app spec's ${db.DATABASE_URL} binding.
# Locally, .env.local points it at the container `npm run dev:up` starts.
DATABASE_URL=

# Encrypts stored provider keys at rest:  openssl rand -base64 32
# The web service encrypts and the worker decrypts, so it must be identical
# across components; rotating it orphans every key users have saved.
ENCRYPTION_KEY=

# --- Object storage ----------------------------------------------------------
# "r2" uses the S3-compatible driver; "local" writes under SPRITEBENCH_DATA_DIR.
STORAGE_DRIVER=r2
R2_BUCKET=spritebench-prod
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: a custom domain in front of the bucket, serving objects directly
# instead of signing every read.
R2_PUBLIC_BASE=
# Optional: overrides the Cloudflare endpoint for MinIO or another
# S3-compatible store. Also what `scripts/verify-s3.ts` points at.
R2_ENDPOINT=
# Only read when STORAGE_DRIVER=local.
SPRITEBENCH_DATA_DIR=./data

# --- Database ----------------------------------------------------------------
# TLS for the query pool and pg-boss alike: "require" or "disable". Managed
# Postgres over the internet needs require; a local container terminates
# nothing. Inferring it from the hostname gets private network names wrong, so
# it is stated outright.
DATABASE_SSL=require

# Connection ceilings, kept low because a redeploy is the peak: the outgoing
# web and worker still hold their pools while the migration job opens its own.
# At 4 + 2 that is 12 steady and 16 mid-deploy, against roughly 22 usable
# connections on a 1 GiB single-node cluster.
DATABASE_POOL_MAX=4
QUEUE_POOL_MAX=2
# How long a shutting-down worker waits for in-flight generations to finish.
QUEUE_DRAIN_TIMEOUT_MS=30000

# --- Limits ------------------------------------------------------------------
# Provider calls in flight at once, per worker process.
WORKER_CONCURRENCY=4
# Images a free account may keep before generation is refused.
FREE_ASSET_LIMIT=100
# Days a full-resolution source is kept before roll-off. Rows and thumbnails
# are kept indefinitely.
ASSET_RETENTION_DAYS=30
# Hard ceiling on batches x imageCount for a single request.
MAX_IMAGES_PER_REQUEST=40

# --- Optional ----------------------------------------------------------------
# Fallback when a user has no stored key. Convenient locally; in production
# users bring their own, so leave it unset there.
OPENAI_API_KEY=
# Pins the acting user. Unset means the first row, created on demand.
SINGLE_USER_ID=
