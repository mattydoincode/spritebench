{
  "rules": [
    {
      "allowed": {
        "origins": ["https://REPLACE-WITH-APP-ORIGIN", "http://localhost:4300"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-None-Match", "If-Modified-Since"]
      },
      "exposeHeaders": ["Content-Length", "Content-Type", "ETag", "Accept-Ranges"],
      "maxAgeSeconds": 3600
    }
  ]
}
