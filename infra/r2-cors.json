{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://spritebench.com",
          "https://www.spritebench.com",
          "https://spritebench-wwp6q.ondigitalocean.app",
          "http://localhost:4300"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Range", "If-None-Match", "If-Modified-Since", "Content-Type"]
      },
      "exposeHeaders": ["Content-Length", "Content-Type", "ETag", "Accept-Ranges"],
      "maxAgeSeconds": 3600
    }
  ]
}
